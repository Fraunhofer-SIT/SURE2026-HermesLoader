    <callotherfixup targetop="getByIdInject">
        <pcode dynamic="true">
            <input name="object" />
            <input name="fieldName" />
            <output name="result" />
        </pcode>
    </callotherfixup>
    <callotherfixup targetop="newArrayWithBufferInject">
        <pcode dynamic="true">
            <input name="sizeHint" />
            <input name="numElements" />
            <input name="bufferIndex" />
            <output name="result" />
        </pcode>
    </callotherfixup>
    <callotherfixup targetop="newObjectWithBufferInject">
        <pcode dynamic="true">
            <input name="sizeHint" />
            <input name="numElements" />
            <input name="bufferKey" />
            <input name="bufferValue" />
            <output name="result" />
        </pcode>
    </callotherfixup>
</compiler_spec>